# 文本文件统一以 LF 行尾入库（Windows 工作区不再产生 CRLF/LF 分叉）
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.vtt text eol=lf
*.srt text eol=lf

# 二进制资源不做行尾转换
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.woff binary
*.woff2 binary
*.wav binary
